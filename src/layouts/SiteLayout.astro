---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { content, localPath, type Locale } from '../i18n/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = content[locale];
const canonical = Astro.site ? new URL(localPath(locale), Astro.site) : undefined;
const favicon = `${import.meta.env.BASE_URL.replace(/\/?$/, '/')}favicon.svg`;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={copy.meta.description} />
    <meta name="theme-color" content="#08b6d8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="ScreenCompanion" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
    <meta name="twitter:card" content="summary" />
    {canonical && <>
      <link rel="canonical" href={canonical} />
      <meta property="og:url" content={canonical} />
      <link rel="alternate" hreflang="en" href={new URL(localPath('en'), Astro.site)} />
      <link rel="alternate" hreflang="ru" href={new URL(localPath('ru'), Astro.site)} />
      <link rel="alternate" hreflang="x-default" href={new URL(localPath('en'), Astro.site)} />
    </>}
    <link rel="icon" href={favicon} type="image/svg+xml" />
    <title>{copy.meta.title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skip}</a>
    <slot />
  </body>
</html>
