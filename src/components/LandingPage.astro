---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from './Header.astro';
import Icon, { type IconName } from './Icon.astro';
import DesktopIllustration from './DesktopIllustration.astro';
import { content, type Locale } from '../i18n/content';
import { product } from '../data/product';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = content[locale];
const featureIcons: IconName[] = ['capture', 'type', 'sliders'];
---
<SiteLayout locale={locale}>
  <div class="site-frame">
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="hero-platform"><Icon name="windows" size={16} />{copy.hero.platform}</p>
          <h1 id="hero-title">{copy.hero.title.map(line => <span>{line}</span>)}</h1>
          <p class="hero-description">{copy.hero.description}</p>
          <div class="hero-actions">
            <a class="button button--black" href={product.release.exe}><Icon name="download" size={19} /><span>{copy.hero.download}</span></a>
            <a class="text-link" href="#how-it-works">{copy.hero.how}</a>
          </div>
          <p class="hero-note">{copy.hero.note}</p>
          <a class="release-link" href={product.release.notes}><span class="release-dot" aria-hidden="true"></span>{copy.hero.release}<span class="release-version">v{product.release.version}</span><Icon name="external" size={13} /></a>
        </div>
        <div class="hero-art"><DesktopIllustration locale={locale} /></div>
      </section>

      <div class="shortcut-strip">
        <div class="shortcut-intro"><span class="shortcut-symbol"><Icon name="capture" size={27} /></span><div><p>{copy.shortcut.title}</p><span>{copy.shortcut.description}</span></div></div>
        <div class="keyboard-shortcut" aria-label={`${copy.shortcut.action} Control Alt Space`}><span class="shortcut-action">{copy.shortcut.action}</span><kbd>Ctrl</kbd><span class="key-plus" aria-hidden="true">+</span><kbd>Alt</kbd><span class="key-plus" aria-hidden="true">+</span><kbd>Space</kbd></div>
      </div>

      <section class="features section-pad" id="features" aria-labelledby="features-title">
        <div class="section-heading"><h2 id="features-title">{copy.features.title}</h2><p>{copy.features.description}</p></div>
        <div class="feature-grid">
          {copy.features.items.map((feature, index) => <article class="feature-item">
            <div class:list={['feature-symbol', `feature-symbol--${index}`]} aria-hidden="true"><Icon name={featureIcons[index]} size={35} />{index === 0 && <span class="feature-check"><Icon name="check" size={13} /></span>}</div>
            <h3>{feature.title}</h3>
            <p>{feature.description}</p>
          </article>)}
        </div>
      </section>

      <section class="providers" aria-labelledby="providers-title">
        <div class="providers-copy"><h2 id="providers-title">{copy.providers.title}</h2><p>{copy.providers.description}</p><p class="provider-note">{copy.providers.note}</p></div>
        <ul class="provider-grid" role="list">{product.providers.map(provider => <li>{provider}</li>)}</ul>
      </section>

      <section class="how section-pad" id="how-it-works" aria-labelledby="how-title">
        <div class="section-heading"><h2 id="how-title">{copy.how.title}</h2><p>{copy.how.description}</p></div>
        <ol class="steps">
          {copy.how.steps.map((step, index) => <li><span class="step-number" aria-hidden="true">{index + 1}</span><h3>{step.title}</h3><p>{step.description}</p></li>)}
        </ol>
        <a class="text-link guide-link" href={product.release.guide}>{copy.how.guide}<Icon name="external" size={16} /></a>
      </section>

      <section class="privacy-panel" aria-labelledby="privacy-title">
        <div class="privacy-symbol" aria-hidden="true"><Icon name="shield" size={49} /><span class="privacy-spark">✳</span></div>
        <h2 id="privacy-title">{copy.privacy.title}</h2>
        <div class="privacy-copy"><p>{copy.privacy.description}</p><a class="text-link" href={`${product.release.guide}#privacy`}>{copy.privacy.link}<Icon name="external" size={15} /></a></div>
      </section>

      <section class="faq section-pad" id="faq" aria-labelledby="faq-title">
        <div class="faq-intro"><h2 id="faq-title">{copy.faq.title}</h2><p>{copy.faq.description}</p><a class="text-link" href={product.issues}>{copy.faq.help}<Icon name="external" size={15} /></a></div>
        <div class="faq-list">{copy.faq.items.map(item => <details class="faq-item" name="questions"><summary>{item.question}<Icon name="plus" size={23} /></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>
      </section>

      <section class="download-panel" id="download" aria-labelledby="download-title">
        <div class="download-copy"><h2 id="download-title">{copy.download.title.map(line => <span>{line}</span>)}</h2><p>{copy.download.description}</p></div>
        <div class="download-actions"><a class="button button--black" href={product.release.exe}><Icon name="windows" size={18} /><span>{copy.download.button}</span><Icon name="download" size={18} /></a><div class="download-secondary"><a href={product.release.zip}>{copy.download.zip}</a><span aria-hidden="true">/</span><a href={product.release.notes}>{copy.download.notes}</a></div><p>v{product.release.version}<span aria-hidden="true"> — </span>{copy.download.detail}</p></div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="footer-main"><div><a class="footer-brand" href="#top">ScreenCompanion<span class="footer-brand-dot" aria-hidden="true"></span></a><p>{copy.footer.description}</p></div><nav class="footer-links" aria-label={copy.nav.footer}><a href={product.release.guide}>{copy.footer.guide}</a><a href={product.issues}>{copy.footer.issue}</a><a href={product.repository}>GitHub<Icon name="external" size={14} /></a></nav></div>
      <div class="footer-bottom"><a href="https://github.com/Ziyadin23">{copy.footer.madeBy}</a><a class="beta-link" href={product.beta}>{copy.footer.beta}<Icon name="external" size={13} /></a><a class="back-top" href="#top">{copy.footer.top}<Icon name="up" size={16} /></a></div>
    </footer>
  </div>
</SiteLayout>
