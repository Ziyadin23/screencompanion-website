---
import SiteLayout from '../layouts/SiteLayout.astro';
import Header from './Header.astro';
import Icon from './Icon.astro';
import ProductDemo from './ProductDemo.astro';
import FeaturePreview from './FeaturePreview.astro';
import { content, type Locale } from '../i18n/content';
import { product } from '../data/product';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = content[locale];
const previews = ['answer', 'question', 'settings'] as const;
const ru = locale === 'ru';
const privacyFacts = ru
  ? [['История снимков', 'Не сохраняется'], ['Ключи и настройки', 'Зашифрованы'], ['Обработка запросов', 'Ваш провайдер']]
  : [['Screenshot history', 'Not saved'], ['Keys and settings', 'Encrypted'], ['Request processing', 'Your provider']];
---
<SiteLayout locale={locale}>
  <div class="site-frame">
    <Header locale={locale} />
    <main id="main" tabindex="-1">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">{copy.hero.title.map(line => <span>{line}</span>)}</h1>
          <p class="hero-description">{copy.hero.description}</p>
          <div class="hero-actions">
            <a class="button button--black" href={product.release.exe}><Icon name="download" size={19} /><span>{copy.hero.download}</span></a>
            <a class="text-link" href="#how-it-works">{copy.hero.how}</a>
          </div>
          <p class="hero-note">{copy.hero.note}</p>
          <a class="release-link" href={product.release.notes}>{copy.hero.release}<span class="release-version">v{product.release.version}</span><Icon name="external" size={16} /></a>
        </div>
        <ProductDemo locale={locale} />
      </section>

      <section class="features section-pad" id="features" aria-labelledby="features-title">
        <div class="features-intro"><h2 id="features-title" data-reveal>{copy.features.title}</h2><p data-reveal>{copy.features.description}</p></div>
        <div class="feature-list">
          {copy.features.items.map((feature, index) => <article class="feature-item">
            <h3 data-reveal>{feature.title}</h3>
            <p data-reveal>{feature.description}</p>
            <div class="feature-media" data-reveal="media"><FeaturePreview locale={locale} kind={previews[index]} /></div>
          </article>)}
        </div>
      </section>

      <section class="providers section-pad" id="providers" aria-labelledby="providers-title">
        <div class="providers-copy"><h2 id="providers-title" data-reveal>{copy.providers.title}</h2><p data-reveal>{copy.providers.description}</p><p class="provider-note" data-reveal>{copy.providers.note}</p></div>
        <ul class="provider-list" role="list">{product.providers.map(provider => <li data-reveal="row">{provider}</li>)}</ul>
      </section>

      <section class="how section-pad" id="how-it-works" aria-labelledby="how-title">
        <div class="section-heading"><h2 id="how-title" data-reveal>{copy.how.title}</h2><p data-reveal>{copy.how.description}</p></div>
        <ol class="steps">
          {copy.how.steps.map((step, index) => <li>
            <div class:list={['setup-visual', `setup-visual--${index}`]} data-reveal="media">
              {index === 0 && <div class="download-file"><Icon name="download" size={40} /><span>SC<span class="file-extension">.exe</span></span><span class="file-detail">Windows x64</span></div>}
              {index === 1 && <div class="setup-provider" data-ui><div class="preview-toolbar"><Icon name="sliders" size={18} /><span>Models & API</span></div><div class="setup-provider-content"><span>{ru ? 'Провайдер' : 'Provider'}</span><strong>OpenAI</strong><span>{ru ? 'Ваш API-ключ' : 'Your API key'}</span><span class="example-api-key" aria-label={ru ? 'Скрытый пример ключа' : 'Masked example key'}>••••••••••••</span></div></div>}
              {index === 2 && <div class="setup-shortcut"><span class="app-monogram" aria-hidden="true">SC</span><p>Ctrl + Alt</p><span class="space-key">Space<Icon name="external" size={26} /></span></div>}
            </div>
            <h3 data-reveal>{step.title}</h3><p data-reveal>{step.description}</p>
          </li>)}
        </ol>
        <a class="text-link guide-link" href={product.release.guide}>{copy.how.guide}<Icon name="external" size={16} /></a>
      </section>

      <section class="privacy-panel section-pad" aria-labelledby="privacy-title">
        <div class="privacy-intro"><h2 id="privacy-title" data-reveal>{copy.privacy.title}</h2><a class="text-link" href={`${product.release.guide}#privacy`}>{copy.privacy.link}<Icon name="external" size={18} /></a></div>
        <div class="privacy-copy"><p data-reveal>{copy.privacy.description}</p><dl class="privacy-facts">{privacyFacts.map(([term, value]) => <div data-reveal="row"><dt>{term}</dt><dd>{value}</dd></div>)}</dl></div>
      </section>

      <section class="faq section-pad" id="faq" aria-labelledby="faq-title">
        <div class="faq-intro"><h2 id="faq-title" data-reveal>{copy.faq.title}</h2><p data-reveal>{copy.faq.description}</p><a class="text-link" href={product.issues}>{copy.faq.help}<Icon name="external" size={18} /></a></div>
        <div class="faq-list">{copy.faq.items.map(item => <details class="faq-item" name="questions" data-reveal="row"><summary>{item.question}<Icon name="plus" size={23} /></summary><div class="faq-answer"><p>{item.answer}</p></div></details>)}</div>
      </section>

      <section class="download-panel section-pad" id="download" aria-labelledby="download-title">
        <div class="download-copy"><h2 id="download-title" data-reveal>{copy.download.title.map(line => <span>{line}</span>)}</h2><p data-reveal>{copy.download.description}</p></div>
        <div class="download-actions" data-reveal><a class="button button--cyan" href={product.release.exe}><Icon name="windows" size={18} /><span>{copy.download.button}</span><Icon name="download" size={18} /></a><div class="download-secondary"><a href={product.release.zip}>{copy.download.zip}</a><a href={product.release.notes}>{copy.download.notes}</a></div><p>v{product.release.version}. {copy.download.detail}</p></div>
      </section>
    </main>

    <footer class="site-footer">
      <a class="footer-wordmark" href="#top" aria-label="ScreenCompanion">ScreenCompanion</a>
      <div class="footer-main"><p>{copy.footer.description}</p><nav class="footer-links" aria-label={copy.nav.footer}><a href={product.release.guide}>{copy.footer.guide}</a><a href={product.issues}>{copy.footer.issue}</a><a href={product.repository}>GitHub<Icon name="external" size={16} /></a></nav></div>
      <div class="footer-bottom"><a href="https://github.com/Ziyadin23">{copy.footer.madeBy}</a><a class="beta-link" href={product.beta}>{copy.footer.beta}<Icon name="external" size={13} /></a><a class="back-top" href="#top">{copy.footer.top}<Icon name="up" size={16} /></a></div>
    </footer>
  </div>
</SiteLayout>

<script>
  import '../scripts/interactions';
</script>
