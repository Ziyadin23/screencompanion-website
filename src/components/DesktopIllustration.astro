---
import { content, type Locale } from '../i18n/content';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = content[locale].art;
---
<div class="desktop-illustration">
  <svg class="desktop-scene" viewBox="0 0 640 570" role="img" aria-label={copy.alt} xmlns="http://www.w3.org/2000/svg">
    <defs>
      <clipPath id="screen-clip"><rect x="106" y="137" width="414" height="259" rx="5" /></clipPath>
      <pattern id="dot-paper" width="16" height="16" patternUnits="userSpaceOnUse"><circle cx="2" cy="2" r="1" fill="#c3ccc5" /></pattern>
    </defs>

    <!-- A loose orbit makes the little screen feel part of a bigger world. -->
    <path d="M486 78c85 16 137 80 121 149-12 50-60 64-108 48" fill="none" stroke="#ffd43b" stroke-width="35" />
    <path d="M97 222C3 228 8 349 83 412c78 65 212 89 292 47" fill="none" stroke="#7bd49b" stroke-width="37" />
    <path d="M94 222C2 228 8 349 84 412" fill="none" stroke="#000" stroke-width="1.5" />
    <circle cx="554" cy="127" r="10" fill="#fff" stroke="#000" stroke-width="1.5" />
    <path d="m102 83 8 19 20 6-20 7-8 20-7-20-20-7 20-6z" fill="#fff" stroke="#000" stroke-width="1.5" />
    <path d="m561 421 5 13 14 5-14 5-5 14-5-14-14-5 14-5z" fill="#fff" stroke="#000" stroke-width="1.5" />
    <path d="M165 57c15-8 34-9 48-1m-36-17c12-5 23-4 33-1" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" />

    <!-- The monitor and its question. All lettering is localized live SVG text. -->
    <g transform="rotate(-7 316 277)">
      <path d="M274 392h73l12 67h-96z" fill="#1765c1" stroke="#000" stroke-width="2" />
      <path d="M247 456h130c8 0 15 7 15 15H232c0-8 7-15 15-15Z" fill="#1765c1" stroke="#000" stroke-width="2" />
      <rect x="92" y="108" width="442" height="311" rx="13" fill="#1765c1" stroke="#000" stroke-width="2" />
      <rect x="106" y="122" width="414" height="275" rx="5" fill="#fffdf6" stroke="#000" stroke-width="1.5" />
      <g clip-path="url(#screen-clip)">
        <rect x="106" y="151" width="414" height="246" fill="url(#dot-paper)" />
        <path d="M106 154h414" stroke="#000" stroke-width="1.5" />
        <rect x="149" y="197" width="310" height="157" fill="#fff" stroke="#000" stroke-width="1.5" />
        <path d="M149 227h310" stroke="#000" stroke-width="1" />
        <circle cx="164" cy="213" r="3" fill="#08b6d8" />
        <text x="176" y="217" class="scene-label">{copy.screen}</text>
        <text x="173" y="255" class="scene-prompt">{copy.prompt}</text>
        <text x="173" y="292" class="scene-equation">2x + 6 = 14</text>
        <path d="M174 313h129m-129 12h87" stroke="#bcc4c1" stroke-width="5" />
        <path d="M139 184h-9v9m338-9h9v9m-347 162v10h9m338-10v10h-9" fill="none" stroke="#000" stroke-width="2" />
        <path d="M159 372h74m9 0h28" stroke="#c9cfcb" stroke-width="4" />
      </g>
      <circle cx="121" cy="138" r="3.5" fill="#fa8050" stroke="#000" stroke-width="1" />
      <circle cx="135" cy="138" r="3.5" fill="#ffd43b" stroke="#000" stroke-width="1" />
      <circle cx="149" cy="138" r="3.5" fill="#83db60" stroke="#000" stroke-width="1" />
      <rect x="290" y="134" width="61" height="7" rx="3.5" fill="#d4dad6" />
      <circle cx="313" cy="407" r="3" fill="#fff" />
    </g>

    <!-- Rounded fingertips and a relaxed open palm beside the monitor. -->
    <g transform="translate(93 344) rotate(35) scale(.85)" stroke="#000" stroke-linecap="round" stroke-linejoin="round">
      <path d="M22 109V93C12 86 6 76 0 65L-11 47C-14 42-13 37-9 35C-5 33-1 35 2 39L15 55V16C15 10 19 7 24 7S33 11 33 16V44L34 5C34-1 38-5 43-5S52-1 52 5V44L54 13C54 7 58 4 63 5S71 10 71 16L70 49L74 29C75 23 79 20 84 21S92 27 91 32L87 73C86 83 81 90 75 95V109Z" fill="#f98450" stroke-width="1.8" />
      <path d="M16 56 30 70C35 75 37 81 36 87M33 45V63M52 45V62M70 50V65M21 29H28M39 22H46M59 30H65" fill="none" stroke="#a04c32" stroke-width="1.2" />
      <path d="M16 101H82L101 239H-3Z" fill="#1765c1" stroke-width="2" />
      <path d="M20 111H78" fill="none" stroke="#fff" stroke-width="1.5" />
    </g>

    <g transform="rotate(5 433 366)">
      <rect x="292" y="282" width="273" height="172" fill="#000" />
      <rect x="283" y="273" width="273" height="172" fill="#fff" stroke="#000" stroke-width="2" />
      <path d="M283 273h273v36H283z" fill="#ffd43b" stroke="#000" stroke-width="2" />
      <text x="298" y="297" class="scene-app-name">SC</text>
      <text x="329" y="295" class="scene-panel-title">{copy.answer}</text>
      <path d="M534 286v9m-4.5-4.5h9" stroke="#000" stroke-width="1.5" />
      <text x="303" y="362" class="scene-answer">x = 4</text>
      <text x="303" y="389" class="scene-explanation">{copy.explanation}</text>
      <path d="M304 414h67" stroke="#08b6d8" stroke-width="7" />
      <path d="m507 344 2 44 11-10 13 22 10-6-13-22 15-3z" fill="#fff" stroke="#000" stroke-width="2" stroke-linejoin="round" />
    </g>
    <path d="M196 489c12 15 29 17 46 10" fill="none" stroke="#000" stroke-width="1.5" stroke-linecap="round" />
    <circle cx="190" cy="458" r="4" fill="#fff" />
    <circle cx="559" cy="221" r="4" fill="#000" />
  </svg>
  <span class="illustration-caption">{copy.label}</span>
</div>
