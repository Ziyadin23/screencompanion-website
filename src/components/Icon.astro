  {name === 'windows' && <><path d="M3 5.5 11 4.4v7H3zm10-1.4L22 3v8.4h-9zM3 13h8v7L3 18.9zm10 0h9v8.4l-9-1.2z" fill="currentColor" stroke="none" /></>}
