---
export type IconName = 'windows' | 'github' | 'download' | 'external' | 'capture' | 'type' | 'sliders' | 'plus' | 'up' | 'check' | 'shield';
interface Props { name: IconName; size?: number; class?: string }
const { name, size = 24, class: className } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class={className} aria-hidden="true" focusable="false">
  {name === 'windows' && <><path d="M3 5.5 11 4.4v7H3zm10-1.4L22 3v8.4h-9zM3 13h8v7L3 18.9zm10 0h9v8.4l-9-1.2z" fill="currentColor" stroke="none" /></>}
  {name === 'github' && <path d="M9 19c-4.3 1.3-4.3-2.2-6-2.6M15.5 22v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.6-1.3 5.6-6A4.7 4.7 0 0 0 19 6.9a4.4 4.4 0 0 0-.1-3.3s-1-.3-3.4 1.3a11.5 11.5 0 0 0-6.2 0C6.9 3.3 5.9 3.6 5.9 3.6a4.4 4.4 0 0 0-.1 3.3 4.7 4.7 0 0 0-1.3 3.3c0 4.7 2.9 5.7 5.6 6a3 3 0 0 0-.8 2.3V22" />}
  {name === 'download' && <><path d="M12 3v12m-5-5 5 5 5-5M4 16v5h16v-5" /></>}
  {name === 'external' && <><path d="M6 18 18 6M6 6h12v12" /></>}
  {name === 'capture' && <><path d="M8 3H3v5m13-5h5v5M3 16v5h5m13-5v5h-5" /><rect x="7" y="7" width="10" height="10" rx="1" /><path d="m10 12 1.5 1.5L15 10" /></>}
  {name === 'type' && <><path d="M4 6h16M12 6v14m-4 0h8M4 4v5m16-5v5" /></>}
  {name === 'sliders' && <><path d="M4 7h7m4 0h5M4 17h3m4 0h9" /><circle cx="13" cy="7" r="2" /><circle cx="9" cy="17" r="2" /></>}
  {name === 'plus' && <path d="M12 5v14M5 12h14" />}
  {name === 'up' && <path d="m5 11 7-7 7 7M12 4v16" />}
  {name === 'check' && <path d="m5 12 4 4L19 6" />}
  {name === 'shield' && <><path d="M12 2 3 6v6c0 5 9 10 9 10s9-5 9-10V6z" /><path d="m8 12 3 3 5-6" /></>}
</svg>
